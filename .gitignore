# macOS
.DS_Store

# Xcode — пользовательские/build артефакты
xcuserdata/
*.xcuserstate
*.xcuserdatad
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/configuration/

# Сессионные артефакты (канон рабочей зоны)
.tmp/
.playwright-mcp/

# Engineering OS: рабочая зона платформы (worktree задач, proofs, журнал, run-state).
# Не код продукта — генерируется пайплайном под корнем репозитория.
.engineering-os/

# Секреты — никогда не коммитить
*.p8
*.p12
*.env
*.env.local

# Модель WhisperKit — качается в рантайме (~626 МБ), в репо не место
*.mlmodelc/
*.mlpackage/
Models/

# Прочее локальное
.mcp.json

# Внутренняя «кухня» метода (Engineering-OS контрол-слой) — в публичный
# репозиторий НЕ выгружать. GitHub видит только собираемый продукт.
/spec/
/docs/
/changes/
/tasks/
/runbook.yaml
/project.yaml
/PROJECT_IDEA.md
/WORKING_CONTRACT.md
/CLAUDE.md
/AGENTS.md
# Приватные тест-ассеты: реальные голосовые (возможен PII) не публикуем.
/VoicePasteTests/Fixtures/
