*.env.local

# Модель WhisperKit — качается в рантайме (~626 МБ), в репо не место
*.mlmodelc/
*.mlpackage/
Models/

# Прочее локальное
.mcp.json

# Внутренняя «кухня» метода — в публичный репозиторий НЕ выгружать.
# Файлы остаются локально, но GitHub видит только собираемый продукт.
/spec/
/knowledge/
/PROJECT_IDEA.md
/WORKING_CONTRACT.md
/CLAUDE.md
/AGENTS.md
