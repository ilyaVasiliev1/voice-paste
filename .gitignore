# macOS
.DS_Store

# Xcode — пользовательские/build артефакты
xcuserdata/
*.xcuserstate
*.xcuserdatad
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/configuration/

# Сессионные артефакты (канон рабочей зоны)
.tmp/
.playwright-mcp/

# Секреты — никогда не коммитить
*.p8
*.p12
*.env
*.env.local

# Не секрет: объявление тихого режима для tools/serve.sh (T-0005) — в нём
# нет ничего, кроме имени переменной, и без него serve.sh некому сказать,
# как не мешать установленной копии. *.env выше молча проглотил бы и его.
!tools/serve.env

# Модель WhisperKit — качается в рантайме (~626 МБ), в репо не место
*.mlmodelc/
*.mlpackage/
Models/

# Спека, память проекта, замысел и направление в репозиторий входят намеренно:
# продукт самодостаточен только вместе со своим намерением и причинами решений.
# Приватные тест-ассеты: реальные голосовые (возможен PII) не публикуем.
/VoicePasteTests/Fixtures/

# Вывод оркестратора и доказательства прогонов: машинное, не исходники.
artifacts/

# T-0010: базовая линия назначенного требования подписи установленной копии —
# состояние конкретной машины (какое удостоверение сейчас стоит), не
# исходники. Пишет и читает scripts/verify-local.sh.
/.codesign-requirement-baseline.txt
